#!/usr/sbin/nft -f
# Generated by Ansible from policy/network.yml. Do not edit on the firewall.
# Default deny: only the flows listed in the policy are forwarded.
flush ruleset

define OFFICE = {{ network.office_supernet }}
{% for name, zone in network.zones.items() if name != 'internet' %}
define Z_{{ name | upper }} = {{ zone.subnet }}
{% endfor %}

table inet filter {

  # Traffic addressed to the firewall itself.
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    ip saddr $Z_MGMT icmp type echo-request accept comment "Troubleshooting from IT"
    limit rate 10/second burst 20 packets log group 1 prefix "FW-DROP src=to-firewall "
  }

  # Traffic between segments.
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    ip saddr $Z_MGMT icmp type echo-request accept comment "Troubleshooting from IT"

{% for flow in network.flows %}
{%   set dst = 'ip daddr != $OFFICE' if flow.to == 'internet' else 'ip daddr $Z_' ~ (flow.to | upper) %}
{%   for proto in ['tcp', 'udp'] %}
{%     set ports = flow.ports | select('search', '/' ~ proto ~ '$') | map('regex_replace', '/.*$', '') | list %}
{%     if ports %}
    ip saddr $Z_{{ flow.from | upper }} {{ dst }} {{ proto }} dport { {{ ports | join(', ') }} } accept comment "{{ flow.from }} -> {{ flow.to }}: {{ flow.why }}"
{%     endif %}
{%   endfor %}
{% endfor %}

    # Everything else is dropped by policy. Log it first (rate-limited), tagged with the source zone.
{% for name in network.zones if name != 'internet' %}
    ip saddr $Z_{{ name | upper }} limit rate 20/second burst 40 packets log group 1 prefix "FW-DROP src={{ name }} "
{% endfor %}
    ip saddr != $OFFICE limit rate 20/second burst 40 packets log group 1 prefix "FW-DROP src=internet "
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

# Office traffic to the internet leaves with the firewall's address.
table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    ip saddr $OFFICE ip daddr != $OFFICE masquerade
  }
}
