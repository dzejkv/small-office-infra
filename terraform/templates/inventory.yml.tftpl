# Generated by Terraform from policy/network.yml. Do not edit by hand.
all:
  vars:
    ansible_connection: community.docker.docker
    ansible_python_interpreter: /usr/bin/python3
    name_prefix: ${prefix}
    enable_siem: ${enable_siem}
  children:
    controller:
      hosts:
        localhost:
          ansible_connection: local
          ansible_python_interpreter: "{{ ansible_playbook_python }}"
    firewall:
      hosts:
        fw:
          ansible_host: ${prefix}-fw
%{ for zone in zones ~}
    zone_${zone}:
      hosts:
%{ for name, h in hosts ~}
%{ if h.zone == zone ~}
        ${name}:
          ansible_host: ${prefix}-${name}
          office_ip: ${h.ip}
          office_zone: ${zone}
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
